# Server config
PORT=3030
ENVIRONMENT="development"

# security
JWT_SECRET="your-jwt-secret"
PASSWORD_SALT="your-password-salt"
REFRESH_JWT_SECRET="your-refresh-jwt-secret"
JWT_ACCESS_EXPIRY="30m"
JWT_REFRESH_EXPIRY="10d"
SALT_ROUNDS=7
HASHING_ALGORITHM="sha256"

# database
DB_USER="kaif"
DB_PASSWORD="your-db-password"
DB_NAME="Eamxify"
DB_PORT="5432"
DATABASE_URL_NEON="postgresql://..."

## totp
OTP_SECRET_KEY="your-otp-secret"
TIME_WINDOW=60
LOOK_BACK=60
LOOK_FORWARD=60
MAX_ATTEMPS=5

## Email
SEND_BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_MAIL="your-email@example.com"
BREVO_SENDER_NAME="ClassRoom"

# Client settings
CLIENT_URL="http://localhost:5001"

## Redis config
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

## AWS S3 Config
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET="classroom-attachments"
AWS_S3_PUT_EXPIRY=900
AWS_S3_GET_EXPIRY=900
